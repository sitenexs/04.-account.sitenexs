<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profil Saya - Sitenexs</title>
    <meta name="description" content="Halaman profil akun pengguna Sitenexs." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-light: #eff6ff;
            --danger: #ef4444;        
            --danger-dark: #dc2626;   
            --bg-body: #f1f5f9;
            --bg-panel: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-light: #e2e8f0;
            --border-focus: #bfdbfe;
            
            /* Shadow yang lebih tipis/soft */
            --shadow-card: 0 2px 10px -2px rgba(15, 23, 42, 0.05);
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.04);
            
            --radius-sm: 0.4rem;
            --radius-md: 0.6rem;
            --radius-lg: 1rem;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-body);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            -webkit-font-smoothing: antialiased;
        }

        a { text-decoration: none; color: inherit; transition: 0.2s; }
        button { font: inherit; outline: none; border: none; cursor: pointer; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Container - Lebih slim */
        .container {
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
            padding-left: 1rem;
            padding-right: 1rem;
        }

        /* Topbar Ramping */
        .topbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-light);
            position: sticky;
            top: 0;
            z-index: 50;
            height: 56px; /* Dikecilkan */
            display: flex;
            align-items: center;
        }

        .topbar-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 800;
            font-size: 1rem;
        }

        .brand-mark {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid var(--border-light);
        }

        .brand-text {
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .nav {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .nav a:hover { color: var(--primary); }

        /* Tombol - Lebih Tipis */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.3rem;
            padding: 0.5rem 1rem; /* Padding dikurangi */
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 0.8rem; /* Font dikecilkan */
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.2);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }

        .btn-danger {
            background: var(--danger);
            color: #fff;
            width: 100%;
            margin-top: auto;
            box-shadow: 0 2px 6px rgba(239, 68, 68, 0.15);
        }

        .btn-danger:hover {
            background: var(--danger-dark);
            transform: translateY(-1px);
        }

        /* Layout Utama Profil */
        .page { 
            padding: 1.5rem 0 2.5rem; 
            flex: 1; 
            display: flex;
            flex-direction: column;
        }

        .profile-shell {
            display: grid;
            grid-template-columns: 260px 1fr; /* Sidebar dikecilkan */
            gap: 1rem;
            align-items: start;
            animation: fadeIn 0.4s ease-out forwards;
            flex: 1;
        }

        .panel {
            background: var(--bg-panel);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            padding: 1.25rem; /* Padding dalam card dikurangi */
        }

        /* Sidebar Kiri */
        .sidebar { 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            text-align: center; 
            height: 100%; 
            min-height: 320px; /* Minimal tinggi dikurangi */
        }

        .avatar {
            width: 64px; /* Avatar diperkecil */
            height: 64px;
            border-radius: 50%;
            border: 2px solid #fff;
            box-shadow: var(--shadow-sm);
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, var(--primary-light), #dbeafe);
            display: grid;
            place-items: center;
            color: var(--primary-dark);
            font-size: 1.25rem;
            font-weight: 800;
        }

        .name { font-size: 1.05rem; font-weight: 800; color: #0f172a; margin-bottom: 0.1rem;}
        .role { color: var(--text-muted); font-size: 0.75rem; font-weight: 500; }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            margin-top: 0.5rem;
            background: #ecfdf5;
            color: #059669;
            border-radius: 999px;
            padding: 0.2rem 0.6rem;
            font-size: 0.7rem;
            font-weight: 700;
            border: 1px solid #d1fae5;
        }

        /* List Info (Email & UID) - Dibuat bersih tanpa background abu-abu */
        .meta {
            list-style: none;
            width: 100%;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px dashed var(--border-light);
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            margin-bottom: 1.5rem; 
        }

        .meta li {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 500;
            text-align: left;
            padding: 0.2rem 0; /* Padding sangat tipis */
        }

        .meta i { color: var(--primary); font-size: 0.85rem; width: 16px; text-align: center; }

        /* Panel Kanan (Informasi) */
        .main-panel {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--border-light);
        }

        h1 { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.02em; }

        .grid-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
        }

        .info-box {
            border: 1px solid var(--border-light);
            border-radius: var(--radius-md);
            padding: 1rem;
            background: #fafaf9;
            transition: all 0.2s ease;
        }
        
        .info-box:hover { border-color: var(--border-focus); background: #fff; }

        .info-box h3 {
            margin-bottom: 0.75rem;
            font-size: 0.85rem;
            font-weight: 700;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        
        .info-box h3 i { color: var(--primary); font-size: 0.85rem; }

        .info-list { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }

        .info-list li {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }

        .info-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
            color: #94a3b8;
        }

        .info-value {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .info-list.bullets {
            padding-left: 1rem;
            list-style: disc;
            color: var(--text-muted);
            font-size: 0.75rem;
            line-height: 1.4;
            gap: 0.4rem;
        }

        /* Pesan Notifikasi */
        #profile-message {
            margin-top: 1rem;
            padding: 0.6rem 0.8rem;
            border-radius: var(--radius-sm);
            font-size: 0.8rem;
            font-weight: 500;
            display: none;
            text-align: center;
        }
        
        #profile-message:not(:empty) { display: block; }
        .msg-success { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
        .msg-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

        /* Tampilan Mobile */
        @media (max-width: 768px) {
            .profile-shell { grid-template-columns: 1fr; gap: 1rem; }
            .sidebar { 
                min-height: auto; 
                flex-direction: column; 
            }
            .sidebar .btn-danger {
                margin-top: 0.5rem; 
            }
            .header-row { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
            .header-row .btn { width: 100%; }
        }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a href="https://sitenexs.com/" class="brand" aria-label="Kembali ke halaman utama">
                <img src="https://sitenexs.com/assets/logo/logo.png" alt="Logo" class="brand-mark" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Sitenexs&background=2563eb&color=fff&size=28&rounded=true';">
                <span class="brand-text">Sitenexs</span>
            </a>

            <nav class="nav" aria-label="Navigasi">
                <a href="https://sitenexs.com/"><i class="fas fa-home"></i> Beranda</a>
            </nav>
        </div>
    </header>

    <main class="page">
        <div class="container profile-shell">
            
            <aside class="panel sidebar">
                <div id="avatar" class="avatar" aria-hidden="true">SN</div>
                <h2 id="profile-name" class="name">Memuat...</h2>
                <div class="role">Akun Pengguna Sitenexs</div>
                <div class="status"><i class="fas fa-circle" style="font-size: 6px;"></i> <span id="profile-status">Memeriksa sesi...</span></div>

                <!-- Bagian list dibuat tipis/bersih (tanpa background abu-abu lebar) -->
                <ul class="meta">
                    <li><i class="fas fa-envelope"></i> <span id="profile-email">-</span></li>
                    <li><i class="fas fa-id-badge"></i> <span id="profile-uid">-</span></li>
                </ul>

                <button id="sign-out" class="btn btn-danger" type="button">
                    <i class="fas fa-sign-out-alt"></i> Keluar Akun
                </button>
            </aside>

            <section class="panel main-panel">
                <div class="header-row">
                    <h1>Profil Saya</h1>
                    <button id="edit-profile" class="btn btn-primary" type="button">
                        <i class="fas fa-user-edit"></i> Ubah Nama
                    </button>
                </div>

                <div class="grid-info">
                    <div class="info-box">
                        <h3><i class="fas fa-id-card"></i> Informasi Akun</h3>
                        <ul class="info-list">
                            <li>
                                <span class="info-label">Nama Lengkap</span>
                                <span class="info-value" id="account-name">-</span>
                            </li>
                            <li>
                                <span class="info-label">Alamat Email</span>
                                <span class="info-value" id="account-email">-</span>
                            </li>
                            <li>
                                <span class="info-label">Status Email</span>
                                <span class="info-value" id="email-status">-</span>
                            </li>
                            <li>
                                <span class="info-label">Sistem Autentikasi</span>
                                <span class="info-value">Firebase Secure Auth</span>
                            </li>
                        </ul>
                    </div>

                    <div class="info-box">
                        <h3><i class="fas fa-shield-alt"></i> Keamanan & Akses</h3>
                        <ul class="info-list bullets">
                            <li>Akun ini mengamankan data dan akses fitur khusus Anda di ekosistem Sitenexs.</li>
                            <li>Sesi login Anda dienkripsi dan disimpan dengan aman di perangkat ini.</li>
                            <li>Pastikan untuk *Keluar Akun* jika Anda menggunakan perangkat umum.</li>
                        </ul>
                    </div>
                </div>
                
                <div id="profile-message" role="status" aria-live="polite"></div>
            </section>
        </div>
    </main>

    <script type="module">
        import { initializeApp } from 'https://www.gstatic.com/firebasejs/13.1.0/firebase-app.js';
        import {
            getAuth,
            onAuthStateChanged,
            signOut,
            updateProfile
        } from 'https://www.gstatic.com/firebasejs/13.1.0/firebase-auth.js';

        const firebaseConfig = {
            apiKey: 'AIzaSyDuN4zlRaSnmcUSuXE_E84IE7d3Mz8E-N4',
            authDomain: 'sitenexs-62919.firebaseapp.com',
            projectId: 'sitenexs-62919',
            storageBucket: 'sitenexs-62919.firebasestorage.app',
            messagingSenderId: '1060348110644',
            appId: '1:1060348110644:web:e45af14d5f26a9cf8e6761',
            measurementId: 'G-C7YL0Q7YRQ'
        };

        const auth = getAuth(initializeApp(firebaseConfig));
        const message = document.getElementById('profile-message');
        let currentUser = null;

        function showMessage(msg, type = 'msg-success') {
            message.textContent = msg;
            message.className = type;
            setTimeout(() => { message.textContent = ''; message.className = ''; }, 4000);
        }

        onAuthStateChanged(auth, (user) => {
            if (!user) {
                window.location.replace('https://account.sitenexs.com/sign-in/');
                return;
            }

            currentUser = user;
            const name = user.displayName || 'Pengguna Sitenexs';
            const initials = name.trim().split(/\s+/).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
            
            document.getElementById('avatar').textContent = initials || 'S';
            document.getElementById('profile-name').textContent = name;
            document.getElementById('profile-email').textContent = user.email || '-';
            document.getElementById('profile-uid').textContent = `UID: ${user.uid.substring(0,8)}...`;
            document.getElementById('profile-status').textContent = 'Sesi Aktif';
            
            document.getElementById('account-name').textContent = name;
            document.getElementById('account-email').textContent = user.email || '-';
            document.getElementById('email-status').textContent = user.emailVerified ? 'Terverifikasi' : 'Belum Terverifikasi';
        }, (error) => {
            showMessage('Tidak dapat memeriksa sesi. Coba muat ulang.', 'msg-error');
            console.error('Firebase auth check failed:', error);
        });

        document.getElementById('sign-out').addEventListener('click', async () => {
            const btn = document.getElementById('sign-out');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Keluar...';
            btn.disabled = true;
            try {
                await signOut(auth);
                window.location.assign('https://sitenexs.com/');
            } catch (error) {
                btn.innerHTML = '<i class="fas fa-sign-out-alt"></i> Keluar Akun';
                btn.disabled = false;
                showMessage('Gagal keluar. Silakan coba lagi.', 'msg-error');
                console.error('Sign-out failed:', error);
            }
        });

        document.getElementById('edit-profile').addEventListener('click', async () => {
            if (!currentUser) return;
            const nextName = window.prompt('Masukkan nama baru Anda:', currentUser.displayName || '');
            if (nextName === null) return; 
            
            const newName = nextName.trim();
            if (!newName) {
                showMessage('Nama tidak boleh kosong.', 'msg-error');
                return;
            }

            try {
                await updateProfile(currentUser, { displayName: newName });
                
                document.getElementById('profile-name').textContent = newName;
                document.getElementById('account-name').textContent = newName;
                const newInitials = newName.split(/\s+/).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
                document.getElementById('avatar').textContent = newInitials;
                
                showMessage('Nama profil berhasil diperbarui.', 'msg-success');
            } catch (error) {
                showMessage('Gagal memperbarui nama. Silakan coba lagi.', 'msg-error');
                console.error('Profile update failed:', error);
            }
        });
    </script>
</body>
</html>
